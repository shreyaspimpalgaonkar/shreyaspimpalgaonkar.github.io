---
import Base from "../layouts/Base.astro";
const pdf = "/assets/pdf/Shreyas_Pimpalgaonkar_2024.pdf";
---

<Base title="CV" description="Curriculum vitae of Shreyas Pimpalgaonkar.">
  <header class="page-head">
    <div class="section-label">CV</div>
    <h1 class="page-title">Curriculum Vitae</h1>
    <p class="lead-in">
      <a class="dl mono" href={pdf} target="_blank" rel="noreferrer">Download PDF &darr;</a>
    </p>
  </header>
  <div class="page-main">
    <div class="inner">
      <div class="pdf-wrap">
        <iframe src={pdf} title="CV of Shreyas Pimpalgaonkar"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  .dl { color: var(--accent); border-bottom: 1px solid var(--accent-weak); padding-bottom: 2px; font-size: 13px; }
  .pdf-wrap { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; height: 84vh; background: var(--paper); }
  .pdf-wrap iframe { width: 100%; height: 100%; border: 0; }
</style>
