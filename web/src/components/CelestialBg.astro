---
// Fixed, light "Ephemeris" background: soft pigment planets, star-chart specks,
// a quiet ink orbit that tilts with the cursor. Runs on every page.
---

<canvas id="celestial" aria-hidden="true"></canvas>

<style>
  #celestial {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const cv = document.getElementById("celestial") as HTMLCanvasElement | null;
  if (cv) {
    const ctx = cv.getContext("2d")!;
    let W = 0, H = 0, DPR = 1;
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth; H = window.innerHeight;
      cv!.width = W * DPR; cv!.height = H * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    addEventListener("mousemove", (e) => { mouse.tx = e.clientX; mouse.ty = e.clientY; });
    addEventListener("touchmove", (e) => {
      const t = e.touches[0]; if (t) { mouse.tx = t.clientX; mouse.ty = t.clientY; }
    }, { passive: true });

    const planets = [
      { bx: 0.82, by: 0.26, r: 360, col: "255,79,20", a: 0.10, sp: 0.05, ph: 0.0, depth: 0.5 },
      { bx: 0.24, by: 0.82, r: 300, col: "120,140,180", a: 0.12, sp: 0.04, ph: 2.1, depth: 0.8 },
      { bx: 0.66, by: 0.72, r: 210, col: "190,150,120", a: 0.11, sp: 0.06, ph: 4.0, depth: 1.1 },
    ];

    let stars: { x: number; y: number; z: number; r: number; ph: number; tw: number }[] = [];
    function initStars() {
      stars = [];
      const n = Math.round((W * H) / 16000);
      for (let i = 0; i < n; i++)
        stars.push({ x: Math.random() * W, y: Math.random() * H, z: 0.3 + Math.random() * 0.7, r: Math.random() * 1.0 + 0.3, ph: Math.random() * 6.28, tw: 0.25 + Math.random() * 0.6 });
    }

    const t0 = performance.now();
    function frame(now: number) {
      const t = (now - t0) / 1000;
      mouse.x += (mouse.tx - mouse.x) * 0.06;
      mouse.y += (mouse.ty - mouse.y) * 0.06;
      const cx = W / 2, cy = H / 2;
      const mx = (mouse.x - cx) / W, my = (mouse.y - cy) / H;

      ctx.fillStyle = "#F7F7F2"; ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.globalCompositeOperation = "multiply";
      for (const p of planets) {
        const px = p.bx * W + Math.sin(t * p.sp + p.ph) * 30 - mx * p.depth * 26;
        const py = p.by * H + Math.cos(t * p.sp * 0.9 + p.ph) * 24 - my * p.depth * 26;
        const g = ctx.createRadialGradient(px, py, 0, px, py, p.r);
        g.addColorStop(0, `rgba(${p.col},${p.a})`);
        g.addColorStop(0.7, `rgba(${p.col},${p.a * 0.4})`);
        g.addColorStop(1, `rgba(${p.col},0)`);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(px, py, p.r, 0, 6.2832); ctx.fill();
      }
      ctx.restore();

      for (const s of stars) {
        const px = s.x - mx * s.z * 20, py = s.y - my * s.z * 20;
        const a = 0.5 + 0.5 * Math.sin(t * s.tw + s.ph);
        ctx.globalAlpha = (0.1 + 0.22 * a) * s.z;
        ctx.fillStyle = "#3a3b36";
        ctx.beginPath(); ctx.arc(px, py, s.r, 0, 6.2832); ctx.fill();
      }
      ctx.globalAlpha = 1;

      const ox = W * 0.7 + mx * 26, oy = H * 0.52 + my * 16;
      const base = Math.min(W, H);
      const tilt = 0.3 + my * 0.12;
      const spin = t * 0.045 + mx * 0.45;
      const rings = [0.2, 0.3, 0.42];
      ctx.lineWidth = 1;
      rings.forEach((f, i) => {
        const rx = base * f, ry = rx * tilt, rot = spin * (i % 2 ? -1 : 1) + i * 0.5;
        ctx.strokeStyle = `rgba(21,22,20,${0.12 - i * 0.03})`;
        ctx.beginPath(); ctx.ellipse(ox, oy, rx, ry, rot, 0, 6.2832); ctx.stroke();
      });
      const f = rings[1], rx = base * f, ry = rx * tilt, rot = spin * -1 + 0.5;
      const ptOnRing = (a: number) => {
        const ex = rx * Math.cos(a), ey = ry * Math.sin(a);
        return { x: ox + ex * Math.cos(rot) - ey * Math.sin(rot), y: oy + ex * Math.sin(rot) + ey * Math.cos(rot) };
      };
      ctx.lineCap = "round";
      const bodyA = t * 0.22;
      for (let k = 0; k < 14; k++) {
        const p1 = ptOnRing(bodyA - k * 0.05), p0 = ptOnRing(bodyA - (k + 1) * 0.05);
        const a = 1 - k / 14;
        ctx.strokeStyle = `rgba(255,79,20,${a * 0.5})`;
        ctx.lineWidth = a * 2;
        ctx.beginPath(); ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y); ctx.stroke();
      }
      const b = ptOnRing(bodyA);
      ctx.fillStyle = "#FF4F14";
      ctx.beginPath(); ctx.arc(b.x, b.y, 2.6, 0, 6.2832); ctx.fill();

      requestAnimationFrame(frame);
    }
    resize(); initStars();
    mouse.x = mouse.tx = W * 0.5; mouse.y = mouse.ty = H * 0.5;
    requestAnimationFrame(frame);
    addEventListener("resize", () => { resize(); initStars(); });
  }
</script>
